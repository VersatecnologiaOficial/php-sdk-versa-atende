{
  "name": "versa/versa-atende-sdk",
  "description": "SDK para integração com a API Versa Atende",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Versa Saúde"
    }
  ],
  "require": {
    "php": "^8.0|^8.1",
    "illuminate/support": "^9.0|^10.0|^11.0",
    "illuminate/http": "^9.0|^10.0|^11.0",
    "illuminate/database": "^9.0|^10.0|^11.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Versa\\VersaAtende\\": "src/",
      "Versa\\VersaAtende\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Versa\\VersaAtende\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Versa\\VersaAtende\\VersaAtendeServiceProvider"
      ],
      "aliases": {
        "VersaAtende": "Versa\\VersaAtende\\Facades\\VersaAtende"
      }
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "orchestra/testbench": "^7.0"
  },
  "config": {
    "audit": {
      "block-insecure": false,
      "ignore": [
        "PKSA-m5cs-t1y6-qpcs",
        "PKSA-3r5d-mb8f-1qw9",
        "PKSA-mdq4-51ck-6kdq",
        "PKSA-8qx3-n5y5-vvnd"
      ]
    }
  }
}
