{
  "name": "versa/versa-atende-sdk",
  "description": "SDK para integração com a API Versa Atende",
  "type": "library",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/http": "^8.0|^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Versa\\VersaAtende\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Versa\\VersaAtende\\VersaAtendeServiceProvider"
      ],
      "aliases": {
        "VersaAtende": "Versa\\VersaAtende\\Facades\\VersaAtende"
      }
    }
  }
}